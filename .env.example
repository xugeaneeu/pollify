# Copy to .env on the production server and fill in real values.
#   cp .env.example .env && chmod 600 .env

# Postgres credentials. Username/db default to "pollify" if unset.
POSTGRES_USER=pollify
POSTGRES_DB=pollify
POSTGRES_PASSWORD=replace-me-with-a-strong-password

# HMAC secret for issuing/verifying access tokens. Generate with:
#   openssl rand -hex 32
JWT_SECRET=replace-me-with-a-32-byte-random-hex

# Caddy listen address. Leave at :80 for plain HTTP, or set to your
# domain (e.g. pollify.example.com) and Caddy will fetch a Let's
# Encrypt cert automatically. Add "443:443" to web.ports in the compose
# file if you do this.
SITE_ADDRESS=:80
